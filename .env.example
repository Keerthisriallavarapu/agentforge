# Copy to .env and fill in. Only ANTHROPIC_API_KEY or OPENAI_API_KEY is strictly required.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: enables the web_search tool. Get a free key at https://tavily.com
TAVILY_API_KEY=

# Optional: override default models
# AGENTFORGE_PLANNER_MODEL=claude-opus-4-5
# AGENTFORGE_EXECUTOR_MODEL=claude-sonnet-4-5
# AGENTFORGE_CRITIC_MODEL=claude-opus-4-5

# Optional: Qdrant (only needed if using long-term memory)
# AGENTFORGE_QDRANT_URL=http://localhost:6333
